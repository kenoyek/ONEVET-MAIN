# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Payment Gateway (Paystack)
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Application
VITE_APP_URL=http://localhost:3000

# Feature Toggles
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=true

# Customer farm portal: enable only after applying the reviewed ownership migration.
VITE_FEATURE_CUSTOMER_FARMS_ENABLED=true

# Payments remain unavailable until the merchant configuration and release are validated.
VITE_FEATURE_PAYMENTS_ENABLED=false
